# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==============================================================================
PORT=8080
GIN_MODE=release

# ==============================================================================
# CONEXIÓN A BASE DE DATOS (SUPABASE / POSTGRESQL)
# ==============================================================================
# Cadena de conexión principal. Soporta el modo pooler de Supabase.
# El backend de Go limpiará automáticamente parámetros especiales como "supa=" si se proveen.
POSTGRES_URL=postgresql://user:password@aws-host.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# CONFIGURACIÓN DE CORREOS (RESEND)
# ==============================================================================
# API Key de Resend (comienza con re_) para el envío de correos.
RESEND_API_KEY=re_your_resend_api_key

# Remitente de los correos transaccionales (debe ser un dominio verificado en Resend).
EMAIL_FROM=Ámbitos <hola@tudominio.com>

# Correo administrativo para monitorear incidentes o copias de respaldo.
ADMIN_EMAIL=admin@tudominio.com

# ==============================================================================
# PASARELA DE PAGO: MERCADO PAGO
# ==============================================================================
# Llave pública usada en el frontend de Next.js
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx-xxxx

# Access Token de producción/sandbox para la API de checkout de preferencias
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID y Secreto de cliente asociados a tu cuenta de desarrollador
MERCADO_PAGO_CLIENT_ID=6305105820155182
MERCADO_PAGO_CLIENT_SECRET=N15VV14MbQvrtrpvA0rA6wAgQHxYoFy4

# ==============================================================================
# PASARELA DE PAGO: TRANSBANK WEBPAY PLUS
# ==============================================================================
# Código de comercio de producción. Si se deja en blanco o se usa ambiente de integración,
# el backend ocupará el código genérico de pruebas 597055555535.
WEBPAY_COMMERCE_CODE=597055555535

# API Key de producción suministrada por Transbank.
WEBPAY_API_KEY=your_production_webpay_api_key

# Entorno de ejecución: "sandbox" para pruebas de integración o "production" para producción.
WEBPAY_ENV=sandbox

# ==============================================================================
# PASARELA DE PAGO: FLOW.CL
# ==============================================================================
# API Key generada desde el panel de comercio de Flow.
FLOW_API_KEY=your_flow_api_key

# Firma secreta compartida usada para validar la integridad de las peticiones.
FLOW_SECRET=your_flow_secret_key

# Endpoint del API de Flow. Sandbox: https://sandbox.flow.cl/api | Producción: https://www.flow.cl/api
FLOW_URL=https://sandbox.flow.cl/api

# ==============================================================================
# PASARELA DE PAGO: PAYPAL
# ==============================================================================
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key
PAYPAL_SANDBOX_USER=your_paypal_sandbox_user
PAYPAL_SANDBOX_PASSWORD=your_paypal_sandbox_password

# ==============================================================================
# HUAWEI MODELARTS MAAS
# ==============================================================================
HUAWEI_API_KEY=your_huawei_api_key
HUAWEI_OPENAI_ENDPOINT=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
HUAWEI_MODEL=DeepSeek-V3

# PostHog (analítica de comportamiento)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
